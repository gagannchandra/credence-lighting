{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/advertising-2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-automation-control-system",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/posts-7",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/commercial-lighting",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/blog/top-5-lighting-companies-in-dubai-for-2025-brighten-your-space-with-quality-style",
      "destination": "/lighting-company-dubai",
      "permanent": true
    },
    {
      "source": "/2025/10/01/top-5-lighting-companies-in-dubai-for-2025-brighten-your-space-with-quality-style",
      "destination": "/lighting-company-dubai",
      "permanent": true
    },
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/products/strech-ceiling",
      "destination": "/products/stretch-ceiling",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}